extern fn printf(format: *u8, ...) i32;

var counter = 0;
var table: [4]i32;

fn swap(a: *i64, b: *i64) {
    let t = *a;
    *a = *b;
    *b = t;
}

fn get(i: i32) i32 {
    return table[i];
}

fn main() {
    var x = 1;
    var y = 2;
    swap(&x, &y);
    var buf: [16]u8;
    buf[3] = 'z';
    counter = counter + get(2) as i64;
    printf("%ld %ld %d\n", x, y, buf[3]);
}
