// Arrays: a sum, a bubble sort through a pointer, and a 2-D table.
extern fn printf(format: *u8, ...) i32;

// Arrays can't be passed by value; pass a pointer to the first element.
fn sort(a: *i64, n: i64) {
    var i = 0;
    while i < n {
        var j = 0;
        while j < n - 1 - i {
            if a[j] > a[j + 1] {
                let t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn print(a: *i64, n: i64) {
    var i = 0;
    while i < n {
        printf("%ld ", a[i]);
        i = i + 1;
    }
    printf("\n");
}

fn main() {
    var a: [8]i64;
    var i = 0;
    while i < 8 {
        a[i] = (i * 5 + 3) % 8;
        i = i + 1;
    }
    print(&a[0], 8);
    sort(&a[0], 8);
    print(&a[0], 8);

    var sum = 0;
    i = 0;
    while i < 8 {
        sum = sum + a[i];
        i = i + 1;
    }
    printf("sum = %ld\n", sum);

    // Starts as all zeros.
    var table: [3][4]i32;
    printf("table[2][3] = %d\n", table[2][3]);
    var r: i32 = 0;
    while r < 3 {
        var c: i32 = 0;
        while c < 4 {
            table[r][c] = r * 10 + c;
            c = c + 1;
        }
        r = r + 1;
    }
    printf("table[2][3] = %d, table[1][0] = %d\n", table[2][3], table[1][0]);

    // A pointer to a whole array: dereference it, then index.
    let pt = &table;
    printf("(*pt)[1][2] = %d\n", (*pt)[1][2]);
}
