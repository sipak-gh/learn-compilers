// The Game of Life with a glider and a blinker, on fixed-size global
// grids (samples/life.peb uses the heap instead).
extern fn putchar(c: i32) i32;

struct World {
    cells: [8][10]bool,
}

var worlds: [2]World;

fn alive(w: *World, x: i64, y: i64) i64 {
    if x < 0 || x >= 10 || y < 0 || y >= 8 {
        return 0;
    }
    if w.cells[y][x] {
        return 1;
    }
    return 0;
}

fn step(from: *World, to: *World) {
    var y = 0;
    while y < 8 {
        var x = 0;
        while x < 10 {
            let n = alive(from, x - 1, y - 1) + alive(from, x, y - 1) + alive(from, x + 1, y - 1)
                + alive(from, x - 1, y) + alive(from, x + 1, y)
                + alive(from, x - 1, y + 1) + alive(from, x, y + 1) + alive(from, x + 1, y + 1);
            to.cells[y][x] = n == 3 || (n == 2 && from.cells[y][x]);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn print(w: *World) {
    var y = 0;
    while y < 8 {
        var x = 0;
        while x < 10 {
            if w.cells[y][x] {
                putchar('#');
            } else {
                putchar('.');
            }
            x = x + 1;
        }
        putchar('\n');
        y = y + 1;
    }
    putchar('\n');
}

fn main() {
    let w = &worlds[0];
    w.cells[0][1] = true;
    w.cells[1][2] = true;
    w.cells[2][0] = true;
    w.cells[2][1] = true;
    w.cells[2][2] = true;
    w.cells[5][6] = true;
    w.cells[5][7] = true;
    w.cells[5][8] = true;
    var gen = 0;
    while gen < 4 {
        print(&worlds[gen % 2]);
        step(&worlds[gen % 2], &worlds[(gen + 1) % 2]);
        gen = gen + 1;
    }
    print(&worlds[gen % 2]);
}
