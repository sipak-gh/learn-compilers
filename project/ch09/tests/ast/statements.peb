extern fn printf(format: *u8, ...) i32;

fn sign(n: i64) i32 {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

fn main() {
    var i: i64 = 0;
    while i < 10 {
        i = i + 1;
        if i % 2 == 0 { continue; }
        if i > 7 { break; }
        { let s = sign(i); printf("%d\n", s); }
    }
    return;
}
