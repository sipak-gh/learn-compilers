(extern fn printf ((format *u8) ...) i32)
(fn sign ((n i64)) i32
  (if (< n 0)
    (block
      (return (- 1)))
    (if (== n 0)
      (block
        (return 0))
      (block
        (return 1)))))
(fn main ()
  (var i i64 0)
  (while (< i 10)
    (block
      (= i (+ i 1))
      (if (== (% i 2) 0)
        (block
          (continue)))
      (if (> i 7)
        (block
          (break)))
      (block
        (let s (call sign i))
        (call printf "%d\n" s))))
  (return))
