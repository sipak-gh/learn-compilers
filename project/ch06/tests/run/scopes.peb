extern fn printf(format: *u8, ...) i32;
extern fn putchar(c: i32) i32;

fn main() i32 {
    let x = 1;
    {
        let x = x + 10;
        printf("inner %ld\n", x);
    }
    printf("outer %ld\n", x);
    var big = 4294967296;
    if big != 0 {
        putchar('y');
    } else {
        putchar('n');
    }
    putchar('\n');
    return 0;
    printf("never printed\n");
}
