// Strings are arrays of bytes ending in 0.
extern fn printf(format: *u8, ...) i32;
extern fn putchar(c: i32) i32;

fn length(s: *u8) i64 {
    var n = 0;
    while s[n] != 0 {
        n = n + 1;
    }
    return n;
}

fn copy(to: *u8, from: *u8) {
    var i = 0;
    while from[i] != 0 {
        to[i] = from[i];
        i = i + 1;
    }
    to[i] = 0;
}

fn reverse(s: *u8) {
    var i = 0;
    var j = length(s) - 1;
    while i < j {
        let t = s[i];
        s[i] = s[j];
        s[j] = t;
        i = i + 1;
        j = j - 1;
    }
}

fn upper(s: *u8) {
    var i = 0;
    while s[i] != 0 {
        if s[i] >= 'a' && s[i] <= 'z' {
            s[i] = s[i] - 'a' + 'A';
        }
        i = i + 1;
    }
}

fn main() {
    let hello = "Hello, pebble";
    printf("length = %ld\n", length(hello));
    var buf: [32]u8;
    let s = &buf[0];
    copy(s, hello);
    reverse(s);
    printf("%s\n", s);
    upper(s);
    printf("%s\n", &buf[0]);
    var i = 0;
    while buf[i] != 0 {
        if buf[i] != ' ' {
            putchar(buf[i] as i32);
        }
        i = i + 1;
    }
    putchar('\n');
}
