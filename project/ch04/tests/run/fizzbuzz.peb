extern fn printf(format, ...);

fn main() {
    var i = 1;
    while i <= 15 {
        if i % 15 == 0 {
            printf("FizzBuzz\n");
        } else if i % 3 == 0 {
            printf("Fizz\n");
        } else if i % 5 == 0 {
            printf("Buzz\n");
        } else {
            printf("%ld\n", i);
        }
        i = i + 1;
    }
}
