extern fn printf(format, ...);
extern fn putchar(c);

fn main() {
    let x = 1;
    {
        let x = x + 10;
        printf("inner %ld\n", x);
    }
    printf("outer %ld\n", x);
    var big = 4294967296;
    if big {
        putchar('y');
    } else {
        putchar('n');
    }
    putchar('\n');
    return 0;
    printf("never printed\n");
}
